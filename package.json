{
  "name": "claude-profiles-tauri",
  "private": true,
  "version": "0.1.0",
  "description": "Personae — run multiple isolated Claude accounts (Desktop + Claude Code CLI) at once.",
  "type": "module",
  "license": "MIT",
  "author": "Amory Dev <amory.dev@gmail.com>",
  "homepage": "https://claudemux.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amorydev/Personae.git"
  },
  "bugs": {
    "url": "https://github.com/Amorydev/Personae/issues"
  },
  "bin": {
    "personae": "bin/personae.js"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "landing:build": "node landing/build.mjs",
    "landing:deploy": "bash scripts/deploy-landing.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "build:app": "tauri build --no-bundle",
    "deploy": "npm run build:app && npm link",
    "dev:dcp": "cross-env WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS=--remote-debugging-port=9222 tauri dev"
  },
  "dependencies": {
    "pinia": "^2.2.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.5",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.1",
    "cross-env": "^7.0.3",
    "jsdom": "^25.0.0",
    "playwright-core": "^1.47.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
